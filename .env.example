# Reference template only: JARVIS does NOT automatically load `.env`.
# Export selected values from a trusted owner launcher or PowerShell session.
# Never store credentials or other secrets in a tracked environment file.
# Environment: local | test | production
JARVIS_ENVIRONMENT=local
# Prefer an owner-controlled directory outside the source checkout for normal use.
# Example PowerShell value: $env:LOCALAPPDATA\JARVIS
JARVIS_APP_DATA_DIR=.jarvis
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false
# Local AI provider
JARVIS_AI_PROVIDER=ollama
JARVIS_AI_MODEL=llama3.2:3b
JARVIS_AI_ENDPOINT=http://127.0.0.1:11434
JARVIS_AI_TIMEOUT_SECONDS=60
JARVIS_AI_CONTEXT_LIMIT=4096
# Provider settings alone do not activate hardware in the canonical v1 runtime.
JARVIS_STT_ENABLED=false
JARVIS_STT_MODEL=base
JARVIS_STT_DEVICE=
JARVIS_STT_COMPUTE_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_TTS_ENABLED=false
JARVIS_TTS_VOICE=HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Speech\Voices\Tokens\TTS_MS_EN-US_ZIRA_11.0
# Voice activation is opt-in. Idle processing is local wake-word detection only.
JARVIS_VOICE_ENABLED=false
JARVIS_VOICE_WAKE_WORD=Jarvis
JARVIS_VOICE_WAKE_CONFIDENCE_THRESHOLD=0.8
JARVIS_VOICE_COOLDOWN_SECONDS=1.0
# Bounded task-orchestration safeguards (Phase 2)
JARVIS_AGENT_MAX_STEPS=8
JARVIS_AGENT_TIMEOUT_SECONDS=30
JARVIS_AGENT_MAX_REPLANS=2
# Optional Phase 16 multi-agent mode; single-agent remains the default.
JARVIS_MULTI_AGENT_ENABLED=false
JARVIS_MULTI_AGENT_MAX_CONCURRENCY=3
JARVIS_MULTI_AGENT_TIMEOUT_SECONDS=120
# Compiled Trusted Core policy. A mismatched value forces safe mode.
JARVIS_SECURITY_POLICY_VERSION=1
# Privileged/unsupported production capabilities remain disabled in v1.
JARVIS_COMPUTER_ENABLED=false
JARVIS_CAMERA_ENABLED=false
JARVIS_APPLICATION_MANAGEMENT_ENABLED=false
JARVIS_PACKAGE_INSTALLATION_ENABLED=false
JARVIS_IMPROVEMENT_ENABLED=false
JARVIS_REMOTE_APPROVAL_ENABLED=false
JARVIS_AUTONOMOUS_SCHEDULING_ENABLED=false
