# Environment: local | test | production
JARVIS_ENVIRONMENT=local
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_JSON=false
# Local AI provider
JARVIS_AI_PROVIDER=ollama
JARVIS_AI_MODEL=llama3.2:3b
JARVIS_AI_ENDPOINT=http://127.0.0.1:11434
JARVIS_AI_TIMEOUT_SECONDS=60
JARVIS_AI_CONTEXT_LIMIT=4096
# Speech is opt-in. Raw audio remains in memory only.
JARVIS_STT_ENABLED=true
JARVIS_STT_MODEL=base
JARVIS_STT_DEVICE=
JARVIS_STT_COMPUTE_DEVICE=cpu
JARVIS_STT_COMPUTE_TYPE=int8
JARVIS_TTS_ENABLED=true
JARVIS_TTS_VOICE=HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Speech\Voices\Tokens\TTS_MS_EN-US_ZIRA_11.0
# Bounded task-orchestration safeguards (Phase 2)
JARVIS_AGENT_MAX_STEPS=8
JARVIS_AGENT_TIMEOUT_SECONDS=30
JARVIS_AGENT_MAX_REPLANS=2
